# ── AI Chat ────────────────────────────────────────────────────────
# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Contact Form / Booking System ──────────────────────────────────
# n8n webhook URL — receives contact form submissions as JSON
# Format: https://your-n8n-domain.com/webhook/<webhook-id>
# Leave empty to skip (email fallback still fires if RESEND_API_KEY is set)
N8N_WEBHOOK_URL=

# Resend API key — sends email notifications on form submission
# https://resend.com — free tier: 3,000 emails / month
# Leave empty to skip (n8n webhook still fires if N8N_WEBHOOK_URL is set)
RESEND_API_KEY=

# Admin email — who receives the notification email
ADMIN_EMAIL=contact@mdigitaldev.com
